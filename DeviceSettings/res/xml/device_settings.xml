<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/device_settings_title">
    <PreferenceCategory android:title="@string/display_category_title">
        <SwitchPreferenceCompat
            android:key="dc_dimming"
            android:defaultValue="false"
            android:persistent="false"
            android:title="@string/dc_dimming_title"
            android:summary="@string/dc_dimming_summary" />
    </PreferenceCategory>
    <PreferenceCategory
        android:key="haptics_category"
        android:title="@string/haptics_category_title">
        <ListPreference
            android:key="haptic_style"
            android:persistent="false"
            android:title="@string/haptic_effect_style_title"
            android:entries="@array/haptic_effect_style_entries"
            android:entryValues="@array/haptic_effect_style_values" />
    </PreferenceCategory>
</PreferenceScreen>
