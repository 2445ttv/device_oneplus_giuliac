# Bluetooth
bluetooth.device.default_name=OnePlus Ace 5

# Camera
vendor.camera.aux.packagelist=com.android.camera,org.lineageos.aperture,org.lineageos.aperture.dev

# Graphics
debug.sf.auto_latch_unsignaled=1
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.set_idle_timer_ms=80
ro.surface_flinger.set_touch_timer_ms=200

# OPlus Camera
ro.vendor.oplus.market.enname=OnePlus Ace 5
ro.vendor.oplus.market.name=OnePlus Ace 5

# USB
vendor.usb.product_string=OnePlus Ace 5
